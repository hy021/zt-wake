#!/bin/sh /etc/rc.common
# wolhttp —— 让 socat 在本机 127.0.0.1:9999 提供唤醒端点，供 nginx 反代
# 安装：/etc/init.d/wolhttp，chmod +x，enable 后 start

START=96
USE_PROCD=1

PROG=/usr/bin/socat
HANDLER=/usr/local/bin/wol-http
LISTEN_PORT=9999

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" "TCP-LISTEN:$LISTEN_PORT,bind=127.0.0.1,reuseaddr,fork" "EXEC:$HANDLER"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
