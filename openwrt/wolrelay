#!/bin/sh /etc/rc.common
# wolrelay —— 手机经 ZeroTier 唤醒主机：把 UDP 9 唤醒包转成局域网广播
#
# 安装：
#   opkg install socat
#   cp wolrelay /etc/init.d/wolrelay && chmod +x /etc/init.d/wolrelay
#   /etc/init.d/wolrelay enable && /etc/init.d/wolrelay start
#
# 默认全自动（ZT_IP/LAN_BCAST 都是 auto）；要写死就改下面三个变量。

START=95
USE_PROCD=1

PROG=/usr/bin/socat
PORT=9
ZT_IP=auto            # auto = 自动找 zt* 网卡的地址；也可写死，如 192.168.100.5
LAN_IFACE=br-lan      # 局域网主网卡
LAN_BCAST=auto        # auto = 由 LAN_IFACE 的 IP/掩码算出广播地址

calc_bcast() {
	_ipmask=$(ip -4 -o addr show "$1" 2>/dev/null | sed -n 's/.*inet \([0-9.]*\/[0-9]*\).*/\1/p' | head -n 1)
	[ -z "$_ipmask" ] && return 0
	_ip=${_ipmask%/*}
	_p=${_ipmask#*/}
	_oldifs=$IFS
	IFS=.
	set -- $_ip
	IFS=$_oldifs
	_out=""
	_i=0
	for _o in "$@"; do
		_nb=$(( _p - _i * 8 ))       # 本字节里的网络位数
		[ $_nb -lt 0 ] && _nb=0
		[ $_nb -gt 8 ] && _nb=8
		_comp=$(( 255 >> _nb ))      # 剩下的主机位全置 1
		_bo=$(( _o | _comp ))
		_out="$_out${_out:+.}$_bo"
		_i=$(( _i + 1 ))
	done
	printf '%s' "$_out"
}

find_zt_ip() {
	for _if in $(ip -o link show 2>/dev/null | sed -n 's/^[0-9]*: \(zt[^:@ ]*\).*/\1/p'); do
		_ip=$(ip -4 -o addr show "$_if" 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -n 1)
		[ -n "$_ip" ] && printf '%s' "$_ip" && return 0
	done
	return 0
}

start_service() {
	[ "$ZT_IP" = auto ] && ZT_IP=$(find_zt_ip)
	[ -z "$ZT_IP" ] && ZT_IP=0.0.0.0
	[ "$LAN_BCAST" = auto ] && LAN_BCAST=$(calc_bcast "$LAN_IFACE")
	[ -z "$LAN_BCAST" ] && LAN_BCAST=255.255.255.255

	logger -t wolrelay "listen $ZT_IP:$PORT -> $LAN_BCAST:$PORT"

	procd_open_instance
	procd_set_param command "$PROG" \
		"UDP4-RECV:$PORT,bind=$ZT_IP,fork" \
		"UDP4-DATAGRAM:$LAN_BCAST:$PORT,broadcast"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
